{  "type": "root",  "background": {    "image": "minecraft:textures/gui/title/background.png",    "color": "#000000",    "opacity": 0.6  },  "elements": [    {      "type": "image",      "x": 0.5,      "y": 0.2,      "width": 200,      "height": 200,      "texture": "minecraft:textures/gui/title/logo.png"    },    {      "type": "button",      "x": 0.5,      "y": 0.6,      "width": 200,      "height": 40,      "text": "Jogar",      "font": "minecraft:default",      "color": "#FFD700",      "onClick": "minecraft:singleplayer"    },    {      "type": "button",      "x": 0.5,      "y": 0.7,      "width": 200,      "height": 40,      "text": "Multiplayer",      "font": "minecraft:default",      "color": "#FFD700",      "onClick": "minecraft:multiplayer"    },    {      "type": "button",      "x": 0.5,      "y": 0.8,      "width": 200,      "height": 40,      "text": "Opções",      "font": "minecraft:default",      "color": "#FFD700",      "onClick": "minecraft:options"    }  ]}