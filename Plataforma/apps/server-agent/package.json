  "dependencies": {
    "@voidfall/authentication": "0.1.0",
    "@voidfall/contracts": "0.1.0",
    "@voidfall/database": "0.1.0",
    "@voidfall/minecraft-process": "0.1.0",
    "@voidfall/server-backup": "0.1.0",
    "@voidfall/server-configuration": "0.1.0"
  },
  "devDependencies": {
    "@voidfall/configuration-schemas": "0.1.0"
  }
