{
  "name": "@voidfall/server-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Outbound-only identity and heartbeat client for VoidFall server hosts",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
