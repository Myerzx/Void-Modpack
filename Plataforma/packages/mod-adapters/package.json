{
  "name": "@voidfall/mod-adapters",
  "version": "0.1.0",
  "private": true,
  "description": "Groups a reviewed mod's configuration into navigable categories, without adding meaning the file does not carry",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../tools/clean-workspace.mjs && tsc -p tsconfig.build.json",
    "test": "tsx --test test/mod-adapters.test.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@voidfall/configuration-inference": "0.1.0"
  }
}
