{
  "name": "@voidfall/release-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Diffs two workspace inventories, decides whether the result may be distributed, and writes the changelog that follows",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../tools/clean-workspace.mjs && tsc -p tsconfig.build.json",
    "test": "tsx --test test/release-planner.test.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@voidfall/workspace-inventory": "0.1.0"
  }
}
