{
  "name": "@voidfall/workspace-inventory",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only inventory of an imported Minecraft workspace, with edit-level classification per mod",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../tools/clean-workspace.mjs && tsc -p tsconfig.build.json",
    "test": "tsx --test test/workspace-inventory.test.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@voidfall/artifact-inspection": "0.1.0"
  }
}
