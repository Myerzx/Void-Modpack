{
  "name": "@voidfall/sandbox-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Composes, boots and deletes a disposable Minecraft sandbox, never touching the original world",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../tools/clean-workspace.mjs && tsc -p tsconfig.build.json",
    "test": "tsx --test test/sandbox-runner.test.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "boot": "node dist/cli.js"
  },
  "dependencies": {
    "@voidfall/minecraft-process": "0.1.0",
    "@voidfall/workspace-inventory": "0.1.0",
    "@voidfall/configuration-staging": "0.1.0",
    "@voidfall/configuration-inference": "0.1.0"
  },
  "bin": {
    "voidfall-sandbox-boot": "./dist/cli.js"
  }
}
