*.mca
*.dat_old
*.log

# Local build and temporary output
/dist/
/tmp/
*.tmp
*.bak
*.outdated
desktop.ini
.DS_Store

# Graphify machine-local state; the portable graph outputs stay tracked
/graphify-out/.graphify_*
/graphify-out/.needs_update
/graphify-out/cache/
/graphify-out/cost.json
/graphify-out/watcher.pid
/graphify-out/watcher.log

